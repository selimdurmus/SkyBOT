import torch
from google.colab import drive
from transformers import (GPT2Tokenizer, GPT2LMHeadModel, Trainer,
                          TrainingArguments, DataCollatorForLanguageModeling)
from datasets import load_dataset
import os

# 1. Google Drive'ı Bağla
if not os.path.exists('/content/drive'):
    drive.mount('/content/drive')

# --- DOSYA YOLLARI ---
input_file = "/content/drive/MyDrive/trwiki_piril_piril.txt"
drive_checkpoint_path = "/content/drive/MyDrive/gpt2_tr_checkpoints"
output_path = "/content/drive/MyDrive/gpt2_tr_final_model"
# ---------------------

# 2. Model ve Tokenizer Yükleme (355M = gpt2-medium)
model_name = "gpt2-medium"
print(f"Modeller yükleniyor: {model_name}")

tokenizer = GPT2Tokenizer.from_pretrained(model_name)
tokenizer.pad_token = tokenizer.eos_token
model = GPT2LMHeadModel.from_pretrained(model_name)

# 3. Veriyi Yükleme ve Akıllı Tokenize Etme (RAM Çökmesini Önler)
print(f"Veri yükleniyor: {input_file}")
# 1.6 GB için önbellek (cache) klasörü oluşturarak RAM'i koruyoruz
dataset = load_dataset("text", data_files={"train": input_file}, cache_dir="./dataset_cache")

def tokenize_function(examples):
    return tokenizer(examples["text"], truncation=True, max_length=512)

print("Tokenizasyon başlıyor... (1.6 GB için bu işlem birkaç dakika sürebilir)")
tokenized_datasets = dataset.map(
    tokenize_function,
    batched=True,
    num_proc=4,
    remove_columns=["text"],
    keep_in_memory=False # Veriyi RAM yerine diskte işleyerek çökmesini engeller
)

# --- TOKEN SAYISI HESAPLAMA ---
print("Veri setindeki toplam token sayısı hesaplanıyor...")
total_tokens = sum(len(x) for x in tokenized_datasets["train"]["input_ids"])
print(f"📊 Dataset içindeki KESİN toplam token sayısı: {total_tokens:,}")
# ------------------------------

data_collator = DataCollatorForLanguageModeling(tokenizer=tokenizer, mlm=False)

# 4. Eğitim Ayarları (1.6 GB Veri ve Google Drive İçin Optimize Edildi)
training_args = TrainingArguments(
    output_dir=drive_checkpoint_path, # Checkpoint'ler doğrudan Drive'a gidecek
    num_train_epochs=1,
    per_device_train_batch_size=16,   # A100 / L24 için ideal
    gradient_accumulation_steps=4,    # Efektif batch size = 64
    learning_rate=5e-5,
    fp16=True,                        # GPU Hızlandırma aktif
    gradient_checkpointing=True,      # VRAM tasarrufu aktif
    logging_steps=100,
    
    # Checkpoint Ayarları
    save_strategy="steps",
    save_steps=1500,                  # Her 1500 adımda bir Drive'a güvenli kayıt yapılıp yedeklenir
    save_total_limit=2,               # Drive alanının dolmaması için sadece son 2 checkpoint saklanır
    
    weight_decay=0.01,
    report_to="none"
)

# 5. Eğiticiyi Başlat
trainer = Trainer(
    model=model,
    args=training_args,
    train_dataset=tokenized_datasets["train"],
    data_collator=data_collator,
)

print("🚀 Eğitim başlıyor! Drive'daki pırıl pırıl veriler işleniyor...")
trainer.train()

# 6. Final Modelini Doğrudan Drive'a Kaydet
trainer.save_model(output_path)
tokenizer.save_pretrained(output_path)
print(f"✅ EĞİTİM BİTTİ! Modelin şu konuma başarıyla kaydedildi: {output_path}")
